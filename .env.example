# Copy this file to ".env" and fill in the keys for the models you plan to use.
# You do NOT need every key filled in -- dispatch.py will skip any model
# whose provider key is missing and tell you which ones it skipped.

# Mistral AI -- https://console.mistral.ai
MISTRAL_API_KEY=

# Google Gemini -- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Together AI -- covers Llama, Qwen, DeepSeek, GLM, Falcon-H1
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# OpenAI -- optional, chat-only (no fine-tuning for new accounts)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic -- optional, chat-only (no fine-tuning available)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
