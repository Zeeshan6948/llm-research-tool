# Copy this file to ".env" and fill in the keys for the models you plan to use.
# You do NOT need every key filled in -- dispatch.py will skip any model
# whose provider key is missing and tell you which ones it skipped.

# Mistral AI -- https://console.mistral.ai
MISTRAL_API_KEY=

# Swiss AI Apertus (EPFL / ETH Zurich) -- Public AI API (https://api.publicai.co/v1) or CSCS / Infomaniak
# Aliases also accepted: APERTUS_API_KEY, PUBLICAI_API_KEY
SWISS_AI_API_KEY=
# Optional overrides if using a non-PublicAI endpoint (e.g. CSCS: https://api.inference.cscs.ch/v1) or another Apertus checkpoint:
# SWISS_AI_BASE_URL=https://api.publicai.co/v1
# SWISS_AI_MODEL=swiss-ai/apertus-v1.5-70b

# European models via Hugging Face Inference Providers (https://router.huggingface.co/v1):
# covers ALIA-40B (Barcelona Supercomputing Center, Spain/EU) & Bielik-11B (SpeakLeash, Poland/EU)
# https://huggingface.co/settings/tokens  (Aliases also accepted: HUGGINGFACE_API_KEY, HUGGINGFACEHUB_API_TOKEN)
HF_TOKEN=
# Optional overrides if using a dedicated Hugging Face Inference Endpoint or custom checkpoints:
# HF_BASE_URL=https://router.huggingface.co/v1
# ALIA_MODEL=BSC-LT/ALIA-40b-instruct-2606
# BIELIK_MODEL=speakleash/Bielik-11B-v3.0-Instruct

# Scaleway Generative APIs (Europe / Silo AI / EuroLLM) -- https://www.scaleway.com/en/generative-apis/
SCALEWAY_API_KEY=

# Prem AI (Europe / Aleph Alpha) -- https://www.premai.io/
PREM_AI_API_KEY=

# Google Gemini -- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Together AI -- covers Llama, Qwen, DeepSeek, GLM, Falcon-H1
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# OpenAI -- optional, chat-only (no fine-tuning for new accounts)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# If your key is a project-scoped key (starts with sk-proj-), also set:
# https://platform.openai.com/settings/organization/projects
OPENAI_PROJECT_ID=

# Anthropic -- optional, chat-only (no fine-tuning available)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
